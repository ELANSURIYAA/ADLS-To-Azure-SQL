def test_FTC_11_referential_integrity(conn):
    query = """
    SELECT COUNT(*) FROM SinkEnrollment e
    LEFT JOIN SinkMember m ON e.MemberID = m.MemberID
    WHERE m.MemberID IS NULL
    """
    cursor = conn.cursor()
    cursor.execute(query)
    result = cursor.fetchone()[0]
    assert result == 0, f"Found {result} Enrollment records with invalid MemberID reference"

