# Functional test cases

def test_FTC_01_member_mandatory_fields_validation(conn):
    query = """
    SELECT COUNT(*) FROM ErrorRecords WHERE TargetEntity = 'Member' AND (
        ValidationErrors LIKE '%FirstName cannot be null or empty%' OR
        ValidationErrors LIKE '%LastName cannot be null or empty%' OR
        ValidationErrors LIKE '%BirthDate cannot be null%' )
    """
    cursor = conn.cursor()
    cursor.execute(query)
    result = cursor.fetchone()[0]
    assert result >= 0

