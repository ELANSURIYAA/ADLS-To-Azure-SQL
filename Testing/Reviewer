def test_FTC_09_valid_invalid_routing(conn):
    query_valid = "SELECT COUNT(*) FROM SinkMember"
    query_error = "SELECT COUNT(*) FROM SinkErrorRecords"
    cursor = conn.cursor()
    cursor.execute(query_valid)
    valid_count = cursor.fetchone()[0]
    cursor.execute(query_error)
    error_count = cursor.fetchone()[0]
    assert valid_count >= 0 and error_count >= 0

